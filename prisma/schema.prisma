// Prisma 7부터 datasource 블록에 url을 둘 수 없다.
// 연결 문자열은 prisma.config.ts가, 실제 연결은 클라이언트의 어댑터가 맡는다.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 시드가 넣은 것인지 심사자가 만든 것인지 구분한다.
///
/// [데모 초기화]가 이 값 하나로 동작한다 — USER는 지우고 SEED는 그대로 둔다.
/// 심사자가 망가뜨릴 수 없으면 아무것도 눌러보지 않는다. 되돌릴 수 있어야 눌러본다.
enum DataOrigin {
  SEED
  USER
}

/// 아이 한 명. 여러 아이는 아직 다루지 않는다.
///
/// 이름을 여기 두는 이유: 작품마다 묻지 않기 위해서다.
/// 등록은 30초 안에 끝나야 하는데 매번 이름을 받으면 그 30초가 무너진다.
/// 그런데 책 표지에는 부를 이름이 있어야 한다. 그래서 딱 한 번, 여기서만 받는다.
model Profile {
  id        String     @id @default(cuid())
  childName String
  origin    DataOrigin @default(SEED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  artworks Artwork[]
}

/// 작품 = 사진 한 장 + 아이가 한 말 + 만든 날.
model Artwork {
  id        String @id @default(cuid())
  profileId String

  /// 아이가 그림을 내밀며 한 말. 이 서비스의 존재 이유다.
  ///
  /// 그런데 필수가 아니다 — 필수로 막으면 말을 못 받은 날엔 사진도 못 남긴다.
  /// 사진 없는 말은 쓸모없지만, 말 없는 사진은 나중에 채울 수 있다.
  /// 대신 비어 있다는 사실은 목록에서 숨기지 않는다.
  childQuote String?

  /// 날짜만 저장한다. 시각까지 두면 표시할 때마다 시간대를 신경 써야 하는데
  /// "언제 그렸나"에 시·분은 아무 의미가 없다.
  madeOn DateTime @db.Date

  origin    DataOrigin @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  photo   Photo?

  /// 목록은 항상 "이 아이의 작품을 만든 날 역순으로"다. 그 모양 그대로 인덱스를 만든다.
  @@index([profileId, madeOn])
  /// [데모 초기화]가 origin = USER를 통째로 지운다.
  @@index([origin])
}

/// 사진 바이트를 작품과 다른 테이블에 둔다.
///
/// 이유 ①: 목록 화면은 바이트가 필요 없다(<img src="/api/photo/[작품id]">로 따로 받는다).
///   같은 테이블에 두면 목록 쿼리 한 번이 매번 수 MB를 끌고 온다.
///   Prisma의 select로 막을 수는 있지만, "실수하면 조용히 느려지는" 구조는 만들지 않는다.
///   테이블을 나누면 실수 자체가 불가능해진다.
///
/// 이유 ②: 파일로 저장하지 않는 이유.
///   public/은 next start가 부팅 시점에 스캔한다. 실행 중에 파일을 써도 재시작 전까지 404다.
///   볼륨을 붙여도 안 고쳐진다. DB에 넣으면 이 문제가 아예 없다.
model Photo {
  id        String @id @default(cuid())
  artworkId String @unique

  bytes    Bytes
  mimeType String

  /// 있으면 이미지가 로드되기 전에 자리를 잡아둘 수 있다(스크롤 중 화면이 튀지 않는다).
  /// 업로드 경로에서는 아직 못 채우므로 없을 수 있게 둔다.
  width  Int?
  height Int?

  /// 작품을 지우면 사진도 같이 사라진다. 고아 바이트가 남지 않는다.
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
}

// Prisma 7부터 datasource 블록에 url을 둘 수 없다.
// 연결 문자열은 prisma.config.ts가, 실제 연결은 클라이언트의 어댑터가 맡는다.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 시드가 넣은 것인지 심사자가 만든 것인지 구분한다.
///
/// [데모 초기화]가 이 값 하나로 동작한다 — USER는 지우고 SEED는 그대로 둔다.
/// 심사자가 망가뜨릴 수 없으면 아무것도 눌러보지 않는다. 되돌릴 수 있어야 눌러본다.
///
/// 🔴 기본값이 모델마다 엇갈려 있다 — Profile만 SEED이고 나머지는 USER다.
///   Profile은 시드만 만들고 화면에서 만드는 경로가 없어서 그렇게 뒀는데,
///   **읽는 사람 입장에서는 왜 하나만 다른지 코드만 봐서는 알 수 없다.**
///
///   지금은 안 터진다. 시드가 책·주문을 0건으로 비워두기 때문에
///   USER 기본값을 타고 만들어지는 것이 전부 "심사자가 만든 것"이 맞다.
///   그런데 나중에 시드에 책이나 주문을 넣게 되면 `origin`을 명시하지 않는 순간
///   **시드 데이터가 USER로 들어가 [데모 초기화]에 지워진다.**
///   그때 고치기로 하고, 지금은 그 사실을 여기 남긴다.
enum DataOrigin {
  SEED
  USER
}

/// 말한 사람.
///
/// 🔴 이 저장소는 원래 **"어른의 말은 안 받는다"**고 정해뒀다.
///   어른이 아이 그림의 뜻을 정하면 남는 것이 아이의 말이 아니라 부모의 해석이 되기 때문이다.
///   그 판단은 **아이가 말을 할 수 있을 때**의 것이었다.
///
///   지금은 초음파 사진부터 받는다. **태아는 말을 하지 않는다.**
///   그 시기에 말을 안 받으면 이 서비스가 남기겠다고 한 것이 통째로 비고,
///   *"복원할 수 없는 것은 말이다"*라는 주장이 그 구간에서 성립하지 않는다.
///
///   그래서 금지를 푸는 대신 **누가 한 말인지를 저장한다.**
///   부모의 말은 부모의 말로 남는다. 원래 막으려던 것(어른의 말이 아이 말로 둔갑하는 것)은
///   그대로 막히고, 말이 없던 시기가 채워진다.
enum Speaker {
  CHILD
  PARENT
}

/// 아이 한 명. 여러 아이는 아직 다루지 않는다.
///
/// 이름을 여기 두는 이유: 한 점마다 묻지 않기 위해서다.
/// 등록은 30초 안에 끝나야 하는데 매번 이름을 받으면 그 30초가 무너진다.
/// 그런데 책 표지에는 부를 이름이 있어야 한다. 그래서 딱 한 번, 여기서만 받는다.
model Profile {
  id        String     @id @default(cuid())
  childName String
  origin    DataOrigin @default(SEED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// 출산예정일. **임신 주차를 셀 수 있는 유일한 기준**이다.
  ///
  /// 🔑 왜 태어난 날로 대신할 수 없나
  ///   임신 주차는 출산일이 아니라 임신 시작에서 센다. 예정일보다 일찍/늦게 태어나면
  ///   태어난 날을 40주 0일로 놓고 거꾸로 세는 순간 **지난 기록의 주차가 통째로 밀린다.**
  ///   24주에 찍은 초음파가 26주로 표시되는 식이다. 그건 없는 것보다 나쁘다.
  ///   예정일은 태어난 뒤에도 바뀌지 않으므로, 임신 구간의 축은 끝까지 이 값 하나로 고정된다.
  dueOn DateTime? @db.Date

  /// 태어난 날. 생후 일·개월·나이의 기준이다.
  ///
  /// 아직 안 태어났으면 비어 있다. 두 값이 다 비어 있어도 앱은 돈다 —
  /// 그때는 시간 축 없이 날짜만 보인다. **모르면 부르지 않는 것이 지어내는 것보다 낫다.**
  bornOn DateTime? @db.Date

  artworks    Artwork[]
  collections Collection[]
}

/// 한 해 = 한 권. 이 서비스의 목적이다.
///
/// 🔑 Artwork에 collectionId를 두지 않았다.
///   어떤 작품이 어느 책에 들어가는지는 이미 madeOn의 연도가 정한다.
///   외래키를 따로 두면 "madeOn은 2026인데 2025년 책에 담긴 작품" 같은 모순이 만들어질 수 있다.
///   없는 필드는 틀릴 수 없다. 그래서 수록작은 저장하지 않고 매번 연도로 계산한다.
///
///   대가로 "이 작품만 책에서 빼기"는 못 한다. 그건 지금 필요 없다 —
///   이 서비스는 한 해를 통째로 남기려고 만들었지 고르려고 만든 게 아니다.
model Collection {
  id        String @id @default(cuid())
  profileId String

  /// 몇 년치인가. 수록작은 이 값으로 조회한다.
  year Int

  /// 책 표지에 들어갈 말. 기본값을 제안하되 부모가 고칠 수 있다.
  title String

  origin    DataOrigin @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orders  Order[]

  /// "한 해에 한 권"이라는 규칙을 문장이 아니라 DB에 새긴다.
  /// 화면에서 막는 것만으로는 두 번 눌리면 두 권이 생긴다.
  @@unique([profileId, year])
}

/// 접수 → 인쇄 → 배송. 세 단계다.
///
/// "배송완료"를 넣지 않았다. 요구사항이 세 단계이고, 넷째 단계는 실제 배송사
/// 연동 없이는 누가 언제 바꾸는지 설명할 수 없다. 설명 못 하는 상태는 만들지 않는다.
enum OrderStatus {
  RECEIVED
  PRINTING
  SHIPPING
}

/// 책 한 권에 대한 주문.
///
/// 가격·쪽수·배송일 필드가 없다. 그 숫자들은 제작 사양(판형·인쇄·제본)에
/// 달려 있는데 그 사양이 정해지지 않았다. 모르는 값을 그럴듯하게 지어내면
/// 화면은 채워지지만 아무 근거가 없다.
model Order {
  id String @id @default(cuid())

  /// 사람이 읽고 부를 수 있는 번호. cuid는 주문 확인 화면에 띄울 수 없다.
  orderNo String @unique

  collectionId String

  /// 지금 어디까지 왔나. 아래 OrderEvent가 있는데도 이 칸을 따로 두는 이유는
  /// 목록 때문이다. 이벤트만 있으면 목록 10건마다 최신 이벤트를 찾아야 한다.
  /// 대신 상태를 바꾸는 경로를 한 곳으로 몰아 둘이 어긋나지 않게 한다.
  status OrderStatus @default(RECEIVED)

  recipientName  String
  recipientPhone String
  address        String

  /// 중복 제출을 DB가 막는 열쇠. 책id·받는 사람·연락처·주소·시간버킷을 해시한 값이다.
  ///
  /// 🔴 이 열쇠가 한때 **연락처만** 보고 있었다. 그런데 같은 요청인지 판정하는 조회는
  ///   이름·연락처·주소 셋을 다 봤다. 두 판정이 갈라져 있어서, 받는 사람과 주소가 달라도
  ///   연락처가 같으면 둘째 주문이 이 제약에 걸렸고 코드는 그걸 "동시 제출"로 읽었다.
  ///   **한 연락처로 여러 곳에 보내는 것은 정상적인 주문이다.** 지금은 두 판정이 같은 값을 본다.
  ///
  /// 🔑 왜 화면이나 앱이 아니라 여기인가
  ///   조회해서 "없으면 만든다"는 조회와 생성 사이가 비어 있다. 두 요청이 그 틈에
  ///   동시에 들어오면 둘 다 "없다"를 보고 둘 다 만든다. 실제로 그렇게 두 건이 생겼다.
  ///   같은 이유로 책에 @@unique([profileId, year])를 걸었다 —
  ///   "화면에서 막는 것만으로는 두 번 눌리면 두 권이 생긴다."
  ///   주문도 같은 자리이므로 같은 방법으로 막는다.
  ///
  /// 🔑 왜 nullable인가
  ///   Postgres는 NULL을 서로 다른 값으로 본다. 이 칸이 비어 있는 주문은 제약을 안 탄다 —
  ///   이 열이 생기기 전에 만들어진 주문이 그렇고, 그것들을 지어낸 값으로 채우지 않는다.
  dedupKey String? @unique

  origin    DataOrigin @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  collection Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  events     OrderEvent[]

  @@index([collectionId])
  @@index([origin])
}

/// 상태가 언제 어떻게 바뀌었는지.
///
/// 주문 화면에서 사용자가 가장 알고 싶은 건 "지금 상태"가 아니라
/// "언제부터 그 상태였나"다. 현재 상태만 덮어쓰면 그 답이 사라진다.
model OrderEvent {
  id      String @id @default(cuid())
  orderId String

  status     OrderStatus
  note       String?
  occurredAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
}

/// 한 점 = 사진 한 장 + 만든 날 + 도착한 편지들(Letter).
///
/// 🔴 모델 이름이 `Artwork`인 것은 이 저장소가 **그림에서 시작했다는 사실**이 남은 것이다.
///   지금 여기 들어오는 것은 그림만이 아니다 — 만들기·상장·초음파 사진까지 들어온다.
///   이름을 옮기려면 테이블·컬럼·인덱스·주소(`/artwork/[id]`)가 같이 움직이는데,
///   **그 변경이 화면에 주는 것이 없다.** 이름이 맞는지는 화면이 쓰는 말로 판정되므로
///   화면에서는 "작품"을 걷어냈고, 여기 불일치가 남아 있다는 것은 숨기지 않는다(README 한계).
///
/// 🔑 종류(그림/만들기/상장/초음파)를 **묻지 않는다.**
///   물으면 등록이 무거워지는데 **화면이 그 값으로 하는 일이 없다.**
///   격자에서 세로 상장과 가로 그림을 다르게 놓아야 하는 문제는 종류가 아니라 **비율**이 푸는데,
///   비율은 이미 Photo.width/height에 있다. 시기는 **날짜가 정한다.**
///   그리고 종류는 어른이 정하는 분류다 — 이 저장소가 태그를 거절한 것과 같은 축이다.
model Artwork {
  id        String @id @default(cuid())
  profileId String

  /// 🔴 여기 `childQuote String?`과 `quoteBy Speaker`가 있었다. Letter 테이블로 옮겼다.
  ///
  ///   말이 작품당 한 통이면 이 서비스의 명제 — *"복원할 수 없는 것은 말이다"* — 가
  ///   담을 수 있는 것이 한 통뿐이다. 그때 받은 말, 3년 뒤에 다시 물어본 말,
  ///   부모가 한참 지나 쓴 말, 태담 — 전부 **같은 물건에 도착한 서로 다른 시점의 편지**인데
  ///   단일 컬럼에서는 셋째부터 **덮어쓰기로 버려졌다.**
  ///
  ///   옛 컬럼은 남기지 않고 지웠다. 마이그레이션이 같은 SQL 안에서 데이터를 옮기므로
  ///   잃는 것이 없고, 남기면 진실이 둘이 된다 — 검색은 어느 쪽을 보나, 화면은 어느 쪽을 믿나.

  /// 날짜만 저장한다. 시각까지 두면 표시할 때마다 시간대를 신경 써야 하는데
  /// "언제 그렸나"에 시·분은 아무 의미가 없다.
  madeOn DateTime @db.Date

  origin    DataOrigin @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  photo   Photo?
  letters Letter[]

  /// 목록은 항상 "이 아이의 작품을 만든 날 역순으로"다. 그 모양 그대로 인덱스를 만든다.
  @@index([profileId, madeOn])
  /// [데모 초기화]가 origin = USER를 통째로 지운다.
  @@index([origin])
}

/// 한 점에 도착한 편지. 작품 1 : N 편지다.
///
/// 🔑 **writtenOn이 이 테이블의 존재 이유다.** 만든 날(Artwork.madeOn)과
///   쓴 날이 다를 수 있다 — 2019년 배냇저고리 사진에 2026년에 쓴 편지가 붙는다.
///   화면은 그 간격을 말한다("7년 뒤에 쓴 편지"). 간격 계산은 lib/age.ts의
///   describeGap을 그대로 쓴다 — 100일·24개월 경계를 새로 발명하지 않는다.
///
/// 🔑 편지가 여러 통이면 **말이 도착한 시점의 지도**가 생긴다.
///   그때 그 자리에서 받은 말, 3년 뒤에 다시 물어본 말, 태담 —
///   단일 컬럼에서는 이 셋이 서로를 덮어썼다.
model Letter {
  id        String @id @default(cuid())
  artworkId String

  /// 편지 본문. 비어 있는 편지는 만들지 않는다 — 빈 말은 저장할 것이 없다.
  /// "말이 아직 없다"는 상태는 편지 0통이 이미 말한다.
  body String

  /// 누가 썼나. 부모의 말은 부모의 말로 남는다 —
  /// 어른의 해석이 아이 말로 둔갑하는 것을 막는 장치가 이 열이다.
  writtenBy Speaker

  /// 언제 쓴/한 말인가. 서버는 이 값 기준으로 말의 주인을 확정한다 —
  /// **말을 할 수 있었는가는 만든 날이 아니라 말한 날의 사실**이다.
  /// 7살이 신생아 사진에 편지를 쓰면 그건 아이의 말일 수 있다.
  writtenOn DateTime @db.Date

  origin    DataOrigin @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// 작품을 지우면 편지도 같이 사라진다. 고아 편지가 남지 않는다.
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  /// 화면은 항상 "이 작품의 편지를 쓴 날 순으로" 읽는다. 도착한 순서가 지도다.
  @@index([artworkId, writtenOn])
  /// [데모 초기화]가 시드 작품에 얹힌 USER 편지를 지울 때 쓴다.
  @@index([origin])
}

/// 사진 바이트를 작품과 다른 테이블에 둔다.
///
/// 이유 ①: 목록 화면은 바이트가 필요 없다(<img src="/api/photo/[작품id]">로 따로 받는다).
///   같은 테이블에 두면 목록 쿼리 한 번이 매번 수 MB를 끌고 온다.
///   Prisma의 select로 막을 수는 있지만, "실수하면 조용히 느려지는" 구조는 만들지 않는다.
///   테이블을 나누면 실수 자체가 불가능해진다.
///
/// 이유 ②: 파일로 저장하지 않는 이유.
///   public/은 next start가 부팅 시점에 스캔한다. 실행 중에 파일을 써도 재시작 전까지 404다.
///   볼륨을 붙여도 안 고쳐진다. DB에 넣으면 이 문제가 아예 없다.
model Photo {
  id        String @id @default(cuid())
  artworkId String @unique

  bytes    Bytes
  mimeType String

  /// 있으면 이미지가 로드되기 전에 자리를 잡아둘 수 있다(스크롤 중 화면이 튀지 않는다).
  /// 업로드 경로에서는 아직 못 채우므로 없을 수 있게 둔다.
  width  Int?
  height Int?

  /// 작품을 지우면 사진도 같이 사라진다. 고아 바이트가 남지 않는다.
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
}
